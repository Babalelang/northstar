# Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:90210/DBNAME

# Falls back to a local sqlite file automatically if DATABASE_URL is unset,
# which is handy for quick local testing but shouldn't be used in production.
# DATABASE_URL=sqlite:///./vuvadb.sqlite3

# Signs admin login sessions. Set this to a long random string in any
# real deployment - if it's unset, a random one is generated per process
# start, which means everyone gets logged out every time the server restarts.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
